---
import og from '../assets/og.png';
import Logo from '../components/Logo.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** Which nav item is current */
  section?: 'signals' | 'fresh' | 'exits' | 'leaderboard' | 'about' | null;
  /** Keep this page out of search results (thin or address-specific pages) */
  noindex?: boolean;
}
const { title, description, section = null, noindex = false } = Astro.props;
const base = Astro.site ?? new URL('https://fomoradar.app');
const canonical = new URL(Astro.url.pathname, base).href;
// Crawlers need an absolute URL and a raster: Telegram, Twitter and Slack all refuse SVG.
// The file is written by assets/brand/make_brand.py from the same mark as everything else, and
// imported rather than served from public/ so the build puts a content hash in its name. Telegram
// caches a preview image by URL and nothing short of a new URL dislodges it: a regenerated file at
// the old address kept showing the old picture even after @WebpageBot said it had refreshed.
const ogImage = new URL(og.src, base).href;
// No repository yet, and a link to github.com itself is worse than no link at all.
const repo = import.meta.env.PUBLIC_REPO_URL ?? '';
const localMode = import.meta.env.PUBLIC_LOCAL_MODE === 'true';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {(noindex || localMode) && <meta name="robots" content="noindex" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="FOMO Robinhood Radar" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="FOMO Robinhood Radar" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
</head>
<body>
  <div class="wrap">
    <header class="masthead">
      <a class="brand" href="/">
        <Logo size={30} />
        <span class="wordmark">FOMO&nbsp;<i>ROBINHOOD</i>&nbsp;RADAR</span>
      </a>
      <nav class="tabs">
        <a href="/" aria-current={section === 'signals' ? 'page' : undefined}>signals</a>
        <a href="/hot" aria-current={section === 'bursts' ? 'page' : undefined}>bursts</a>
        <a href="/fresh" aria-current={section === 'fresh' ? 'page' : undefined}>fresh</a>
        <a href="/exits" aria-current={section === 'exits' ? 'page' : undefined}>exits</a>
        <a href="/leaderboard" aria-current={section === 'leaderboard' ? 'page' : undefined}>leaderboard</a>
        <a href="/about" aria-current={section === 'about' ? 'page' : undefined}>about</a>
      </nav>
    </header>

    {localMode && <p class="local-instance">Mason’s local Radar · wallet research · no brokerage connection or order execution</p>}

    <main>
      <slot />
    </main>

    <footer class="foot">
      <span>FOMO Robinhood Radar · research, not financial advice</span>
      <span>Robinhood Chain · 4663</span>
      <a href={localMode ? 'http://127.0.0.1:8767/docs' : '/docs'}>API</a>
      {repo && <a href={repo}>source</a>}
    </footer>
  </div>
</body>
</html>

<style>
  .local-instance { padding: 12px 16px; border: 1px solid #263d31; background: #101a15; color: #b3cbbc; font-size: 13px; line-height: 1.5; }
</style>
